# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Uplink Supabase Configuration (for API key validation)
UPLINK_SUPABASE_URL=your_uplink_supabase_url
UPLINK_SUPABASE_KEY=your_uplink_supabase_anon_key
UPLINK_SUPABASE_SERVICE_ROLE_KEY=your_uplink_supabase_service_role_key

# API Access Control
ADMIN_API_KEY=your_admin_api_key

# Single local API key, used when the Uplink key store is not configured
MCP_API_KEY=

# RPC endpoints, one per chain: <CHAIN>_RPC_URL with dashes as underscores
MAINNET_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
SONIC_RPC_URL=
MODE_RPC_URL=
MAINNET_ETHERFI_RPC_URL=
MAINNET_LIDO_RPC_URL=
MAINNET_GHO_RPC_URL=
